{
  "appId": "live.owntemp.app",
  "appName": "Owntemp",
  "webDir": "out",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "owntemp",
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b0f19",
      "showSpinner": false
    }
  }
}
