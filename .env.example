# Owntemp Configuration
NEXT_PUBLIC_APP_NAME="Owntemp"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DEFAULT_DOMAIN="owntemp.live"

# Optional Cloudflare Worker Webhook Authentication Secret
WEBHOOK_SECRET="your-secure-webhook-secret-token"

# Database (PostgreSQL URL when deploying to Vercel/Supabase, or file-backed by default)
DATABASE_URL="postgresql://user:password@localhost:5432/owntemp"
